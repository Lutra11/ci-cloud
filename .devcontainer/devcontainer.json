{
  "name": "ci-cloud backend",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [3000],
  "postStartCommand": "nohup node server.js > server.log 2>&1 & sleep 2 && tail -1 server.log",
  "portsAttributes": {
    "3000": {
      "label": "ci-cloud API",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "node"
}
